#!/bin/bash

# Run your command
module load rocm/7.2.3
source .venv/bin/activate
# export HF_ALLOW_CODE_EVAL="1"

lm_eval \
  --model vllm \
  --model_args "pretrained=Qwen/Qwen3.6-27B,max_model_len=4096,gpu_memory_utilization=0.85,language_model_only=True" \
  --tasks wikitext \
  --batch_size 2 \
  --log_samples \
  --output_path results

lm_eval \
  --model vllm \
  --model_args "pretrained=Qwen/Qwen3.6-27B-FP8,max_model_len=4096,gpu_memory_utilization=0.85,language_model_only=True" \
  --tasks wikitext \
  --batch_size 2 \
  --log_samples \
  --output_path results

lm_eval \
  --model vllm \
  --model_args "pretrained=Qwen3.6-27B-FP8,max_model_len=4096,gpu_memory_utilization=0.85,language_model_only=True" \
  --tasks wikitext \
  --batch_size 2 \
  --log_samples \
  --output_path results

lm_eval \
  --model vllm \
  --model_args "pretrained=Qwen3.6-27B-FP8_KVFP8,max_model_len=4096,gpu_memory_utilization=0.85,language_model_only=True" \
  --tasks wikitext \
  --batch_size 2 \
  --log_samples \
  --output_path results

lm_eval \
  --model vllm \
  --model_args "pretrained=Qwen3.6-27B-MXFP4,max_model_len=4096,gpu_memory_utilization=0.85,language_model_only=True" \
  --tasks wikitext \
  --batch_size 2 \
  --log_samples \
  --output_path results

lm_eval \
  --model vllm \
  --model_args "pretrained=Qwen3.6-27B-MXFP4-KVFP8,max_model_len=4096,gpu_memory_utilization=0.85,language_model_only=True" \
  --tasks wikitext \
  --batch_size 2 \
  --log_samples \
  --output_path results

