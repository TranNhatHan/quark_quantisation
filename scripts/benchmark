guidellm run \
  --backend kind=openai_http,target=http://ppac-pl1-s24-30:8000 \
  --profile kind=sweep,sweep_size=10,max_concurrency=16 \
  --data kind=synthetic_text,prompt_tokens=20000,output_tokens=1000 \
  --constraint kind=max_requests,count=30 \
  --output kind=json,path=results/benchmark-quark-fp8.json \
  --output kind=csv,path=results/benchmark-quark-fp8.csv \
  --output kind=html,path=results/benchmark-quark-fp8.html