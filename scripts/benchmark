#!/bin/bash

module load rocm/7.2.3
source .venv/bin/activate

guidellm run \
  --backend kind=openai_http,target=http://ppac-pl1-s24-30:8000 \
  --profile kind=sweep,sweep_size=2,max_concurrency=10 \
  --data kind=synthetic_text,prompt_tokens=10000,output_tokens=1500 \
  --constraint kind=max_requests,count=50 \
  --output kind=csv,path=results/benchmark-o.csv \
  --output kind=html,path=results/benchmark-o.html